# Copy to .env in the project root and fill in your values.
# Never commit the real .env file.

# Azure DevOps organization name (the part after dev.azure.com/)
ADO_ORG=your-org

# Optional default project. You can also pick one at runtime with set_project.
ADO_PROJECT=MyProject

# Personal Access Token with Work Items (Read & Write) and Test Management (Read & Write)
ADO_PAT=your-personal-access-token
