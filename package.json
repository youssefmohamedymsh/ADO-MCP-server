{
  "name": "ado-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that lets Claude and other AI assistants read Azure DevOps stories, write test cases, log bugs and manage work items",
  "author": "Youssef Mohamed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/youssefmohamedymsh/ado-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "azure-devops",
    "claude",
    "qa",
    "test-automation",
    "test-management"
  ],
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "zod": "^3.23.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
